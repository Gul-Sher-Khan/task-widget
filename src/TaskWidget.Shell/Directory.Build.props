<Project>
  <PropertyGroup>
    <Platform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</Platform>
    <Platform Condition="'$(RuntimeIdentifier)' == 'win-x64' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU')">x64</Platform>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>
</Project>
