<UserControl
    x:Class="TaskWidget.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskWidget">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
            <Setter Property="Margin" Value="4,14,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10,12,12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource FaintTextBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" MaxHeight="520" Padding="12,0,12,4" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,0,8">

            <TextBlock Text="Connection" Style="{StaticResource Section}" Margin="4,4,0,6" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="10" Visibility="{x:Bind local:Row.When(Model.HasConnection), Mode=OneWay}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind Model.AccountInitial, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Model.Account, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Model.Plan, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Sign out" Click="SignOut_Click" Padding="10,4,10,5" FontSize="12.5" />
                        </Grid>
                        <ComboBox x:Name="ModelBox" Header="Model" ItemsSource="{x:Bind Model.ModelChoices, Mode=OneWay}" SelectedIndex="{x:Bind Model.ModelIndex, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" FontSize="13" SelectionChanged="Model_Changed" />
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="{x:Bind local:Row.Unless(Model.HasConnection), Mode=OneWay}">
                        <TextBlock Text="Not signed in" FontSize="13" />
                        <local:SignInBlock Model="{x:Bind Model}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Opens your browser. Task Widget never sees your password." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}"
                               Text="Captures use your ChatGPT plan. Automatic picks the fastest model your plan offers. Only what you capture and today's date are sent to ChatGPT. Nothing else leaves this PC." />
                </StackPanel>
            </Border>

            <TextBlock Text="Hotkey" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Open and add a Capture" FontSize="13" />
                            <TextBlock Text="Tap to open, tap again to add" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="RecordButton" HorizontalAlignment="Right" Click="Record_Click" Padding="8,4,8,5" MinWidth="120">
                            <Grid>
                                <TextBlock Text="{x:Bind Model.Hotkey, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                           Visibility="{x:Bind local:Row.Unless(Recording), Mode=OneWay}" />
                                <TextBlock Text="Press keys…" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind local:Row.When(Recording), Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Model.LanguageToggleWarning, Mode=OneTime}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <ComboBox x:Name="ThemeBox" Header="Theme" ItemsSource="{x:Bind Themes}" SelectedIndex="{x:Bind Model.ThemeIndex, Mode=OneWay}"
                              HorizontalAlignment="Stretch" FontSize="13" SelectionChanged="Theme_Changed" />
                    <ComboBox x:Name="BackdropBox" Header="Backdrop" ItemsSource="{x:Bind Backdrops}" SelectedIndex="{x:Bind Model.BackdropIndex, Mode=OneWay}"
                              HorizontalAlignment="Stretch" FontSize="13" SelectionChanged="Backdrop_Changed" />
                    <TextBlock Style="{StaticResource Caption}" Visibility="{x:Bind local:Row.When(Model.ShowBackdropNote), Mode=OneWay}"
                               Text="Windows transparency effects are off, so every backdrop shows as Solid." />
                </StackPanel>
            </Border>

            <TextBlock Text="Widget" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="Rows before scrolling" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind local:Row.CountText(Model.RowsBeforeScrolling), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="Rows" Minimum="4" Maximum="15" StepFrequency="1"
                            Value="{x:Bind Model.RowsBeforeScrollingValue, Mode=OneWay}" ValueChanged="Rows_Changed" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Start with Windows" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="Startup" IsOn="{x:Bind Model.StartWithWindows, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0"
                                      HorizontalAlignment="Right" Margin="0,0,-12,0" Toggled="Startup_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Model.VersionLine, Mode=OneWay}" FontSize="13" />
                            <TextBlock Text="Open source, MIT" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <HyperlinkButton Content="Privacy" FontSize="12.5" NavigateUri="https://github.com/Gul-Sher-Khan/task-widget#privacy" />
                            <HyperlinkButton Content="GitHub" FontSize="12.5" NavigateUri="https://github.com/Gul-Sher-Khan/task-widget" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}" Margin="-12,0" />

                    <Grid Visibility="{x:Bind local:Row.When(Model.CanCheck), Mode=OneWay}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="You're up to date" FontSize="13" Visibility="{x:Bind local:Row.When(Model.UpdCurrent), Mode=OneWay}" />
                            <TextBlock Text="Couldn't check for updates" FontSize="13" Foreground="{ThemeResource ErrorBrush}"
                                       Visibility="{x:Bind local:Row.When(Model.UpdFailed), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Model.CheckedWhen, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Check now" Click="CheckNow_Click" Padding="10,4,10,5" FontSize="12.5" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Row.When(Model.UpdChecking), Mode=OneWay}" MinHeight="32">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind Model.UpdChecking, Mode=OneWay}" />
                        <TextBlock Text="Checking for updates…" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Visibility="{x:Bind local:Row.When(Model.UpdAvailable), Mode=OneWay}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13">
                                <Run Text="Version" /> <Run Text="{x:Bind Model.NewVersion, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="is available" />
                            </TextBlock>
                            <HyperlinkButton Content="What's new" FontSize="11.5" Padding="0,1,0,2"
                                             NavigateUri="https://github.com/Gul-Sher-Khan/task-widget/releases" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Update" Click="Update_Click" Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,4,12,5" FontSize="12.5" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="6" Visibility="{x:Bind local:Row.When(Model.UpdDownloading), Mode=OneWay}">
                        <TextBlock FontSize="13">
                            <Run Text="Downloading" /> <Run Text="{x:Bind Model.NewVersion, Mode=OneWay}" /><Run Text="…" />
                        </TextBlock>
                        <ProgressBar Maximum="1" Value="{x:Bind Model.Downloaded, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Model.DownloadNote, Mode=OneTime}" />
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="Check for updates automatically" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="Auto" IsOn="{x:Bind Model.AutoUpdate, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0"
                                      HorizontalAlignment="Right" Margin="0,0,-12,0" Toggled="Auto_Toggled" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Once a day, Task Widget asks GitHub for the latest version. Nothing about you or your Tasks is sent. Updates never install without you." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
