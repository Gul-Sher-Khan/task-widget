<UserControl
    x:Class="TaskWidget.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskWidget">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
            <Setter Property="Margin" Value="4,14,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10,12,12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource FaintTextBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" MaxHeight="520" Padding="12,0,12,4" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,0,8">

            <TextBlock Text="Hotkey" Style="{StaticResource Section}" Margin="4,4,0,6" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Open and add a Capture" FontSize="13" />
                            <TextBlock Text="Tap to open, tap again to add" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="RecordButton" HorizontalAlignment="Right" Click="Record_Click" Padding="8,4,8,5" MinWidth="120">
                            <Grid>
                                <TextBlock Text="{x:Bind Model.Hotkey, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                           Visibility="{x:Bind local:Row.Unless(Recording), Mode=OneWay}" />
                                <TextBlock Text="Press keys…" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind local:Row.When(Recording), Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Model.LanguageToggleWarning, Mode=OneTime}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <ComboBox x:Name="ThemeBox" Header="Theme" ItemsSource="{x:Bind Themes}" SelectedIndex="{x:Bind Model.ThemeIndex, Mode=OneWay}"
                              HorizontalAlignment="Stretch" FontSize="13" SelectionChanged="Theme_Changed" />
                    <ComboBox x:Name="BackdropBox" Header="Backdrop" ItemsSource="{x:Bind Backdrops}" SelectedIndex="{x:Bind Model.BackdropIndex, Mode=OneWay}"
                              HorizontalAlignment="Stretch" FontSize="13" SelectionChanged="Backdrop_Changed" />
                    <TextBlock Style="{StaticResource Caption}" Visibility="{x:Bind local:Row.When(Model.ShowBackdropNote), Mode=OneWay}"
                               Text="Windows transparency effects are off, so every backdrop shows as Solid." />
                </StackPanel>
            </Border>

            <TextBlock Text="Widget" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="Rows before scrolling" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind local:Row.CountText(Model.RowsBeforeScrolling), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="Rows" Minimum="4" Maximum="15" StepFrequency="1"
                            Value="{x:Bind Model.RowsBeforeScrollingValue, Mode=OneWay}" ValueChanged="Rows_Changed" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Start with Windows" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="Startup" IsOn="{x:Bind Model.StartWithWindows, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0"
                                      HorizontalAlignment="Right" Margin="0,0,-12,0" Toggled="Startup_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Model.VersionLine, Mode=OneWay}" FontSize="13" />
                            <TextBlock Text="Open source, MIT" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <HyperlinkButton Content="Privacy" FontSize="12.5" NavigateUri="https://github.com/Gul-Sher-Khan/task-widget#privacy" />
                            <HyperlinkButton Content="GitHub" FontSize="12.5" NavigateUri="https://github.com/Gul-Sher-Khan/task-widget" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
