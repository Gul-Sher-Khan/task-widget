<Window
    x:Class="TaskWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskWidget"
    xmlns:core="using:TaskWidget.Core">
    <Grid x:Name="Host" Background="{ThemeResource SurfaceSolidBrush}">
        <Grid x:Name="Root" Width="360" Padding="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="16,10,8,4" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Tasks" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind local:Row.CountText(Model.OpenTaskCount), Mode=OneWay}"
                               Foreground="{ThemeResource FaintTextBrush}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Bare}" Width="30" Height="30" Visibility="Collapsed"
                        ToolTipService.ToolTip="Re-sort by Priority and Effort">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Bare}" Width="30" Height="30"
                        ToolTipService.ToolTip="Done view">
                    <FontIcon Glyph="&#xE81C;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Bare}" Width="30" Height="30"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource Bare}" Width="30" Height="30"
                        ToolTipService.ToolTip="Collapse to the Dock">
                    <FontIcon Glyph="&#xE70E;" FontSize="13" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="12,4,12,6">
                <TextBox x:Name="Capture" MinHeight="36" Padding="10,7,10,6" CornerRadius="6"
                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="13.5"
                         PlaceholderText="Capture a thought…"
                         Text="{x:Bind Model.CaptureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTipService.ToolTip="Type or dictate. Enter adds it, Shift+Enter is a new line." />
            </Grid>

            <ListView x:Name="List" Grid.Row="2" Padding="6,0,6,0"
                      ItemsSource="{x:Bind Model.Tasks, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource PlainRow}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:TaskRow">
                        <Grid Padding="8,7,6,7" ColumnSpacing="10" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource Bare}" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top">
                                <Ellipse Width="17" Height="17" StrokeThickness="1.5" Stroke="{ThemeResource MutedTextBrush}" />
                            </Button>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontSize="13.5" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource FaintTextBrush}" Margin="0,0,4,0"
                                          Visibility="{x:Bind local:Row.WhenDetails(Details), Mode=OneTime}" />
                                <Button Style="{StaticResource Bare}" Padding="4,3,4,3" MinWidth="26">
                                    <local:EffortChip Effort="{x:Bind Effort, Mode=OneTime}" />
                                </Button>
                                <Button Style="{StaticResource Bare}" Padding="4,3,4,3">
                                    <local:PriorityBadge Priority="{x:Bind Priority, Mode=OneTime}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
