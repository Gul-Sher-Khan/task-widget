<Window
    x:Class="TaskWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskWidget"
    xmlns:core="using:TaskWidget.Core">
    <Grid x:Name="Host" Background="{ThemeResource SurfaceSolidBrush}">
        <Grid x:Name="Root" Width="360" Padding="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="16,10,8,4" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind Model.ShowingTasks, Mode=OneWay}">
                    <TextBlock Text="Tasks" FontSize="15" FontWeight="SemiBold"
                               Visibility="{x:Bind local:Row.Unless(Model.ShowingDone), Mode=OneWay}" />
                    <TextBlock Text="Done" FontSize="15" FontWeight="SemiBold"
                               Visibility="{x:Bind local:Row.When(Model.ShowingDone), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind local:Row.CountText(Model.OpenTaskCount), Mode=OneWay}"
                               Foreground="{ThemeResource FaintTextBrush}" FontSize="13" VerticalAlignment="Center"
                               Visibility="{x:Bind local:Row.Unless(Model.ShowingDone), Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="-8,0,0,0" Visibility="{x:Bind Model.SettingsOpen, Mode=OneWay}">
                    <Button Style="{StaticResource Bare}" Width="30" Height="30" Click="Settings_Click" ToolTipService.ToolTip="Back to Tasks">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Bare}" Width="30" Height="30" Click="Resort_Click"
                        ToolTipService.ToolTip="Re-sort by Priority and Effort"
                        Visibility="{x:Bind local:Row.When(Model.HasManualPositions), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                </Button>
<Button Grid.Column="2" Style="{StaticResource Bare}" Width="30" Height="30" Click="Done_Click"
                        ToolTipService.ToolTip="Done view" Visibility="{x:Bind Model.ShowingTasks, Mode=OneWay}">
                    <Grid>
                        <FontIcon Glyph="&#xE81C;" FontSize="14"
                                  Visibility="{x:Bind local:Row.Unless(Model.ShowingDone), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE72B;" FontSize="14"
                                  Visibility="{x:Bind local:Row.When(Model.ShowingDone), Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Bare}" Width="30" Height="30" Click="Settings_Click"
                        ToolTipService.ToolTip="Settings" Visibility="{x:Bind Model.ShowingTasks, Mode=OneWay}">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource Bare}" Width="30" Height="30"
                        Click="Collapse_Click" ToolTipService.ToolTip="Collapse to the Dock">
                    <FontIcon Glyph="&#xE70E;" FontSize="13" />
                </Button>
            </Grid>

            <Grid x:Name="BannerHost" Grid.Row="1" Visibility="{x:Bind local:Row.When(Model.HasBanner), Mode=OneWay}" />

            <Grid Grid.Row="2" Margin="12,4,12,6" Visibility="{x:Bind Model.ShowingCapture, Mode=OneWay}">
                <TextBox x:Name="Capture" MinHeight="36" Padding="10,7,32,6" CornerRadius="6"
                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="13.5"
                         PlaceholderText="{x:Bind Model.CapturePlaceholder, Mode=OneWay}"
                         Text="{x:Bind Model.CaptureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTipService.ToolTip="{x:Bind Model.CaptureTip, Mode=OneWay}" />
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource FaintTextBrush}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                          IsHitTestVisible="False" Visibility="{x:Bind local:Row.When(Model.ReadOnly), Mode=OneWay}" />
                <Button Style="{StaticResource Bare}" Width="22" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Click="ClearDraft_Click"
                        Visibility="{x:Bind local:Row.When(Model.HasDraftText), Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom" Margin="6,0,6,0" IsHitTestVisible="False"
                             Visibility="{x:Bind local:Row.When(Model.WaitingDictation), Mode=OneWay}" />
            </Grid>

            <local:Welcome Grid.Row="3" Card="True" local:Fx.Enter="True"
                           Model="{x:Bind Model}"
                           Visibility="{x:Bind local:F.Both(Model.ShowWelcome, Model.ShowingTasks), Mode=OneWay}" />

            <Grid Grid.Row="4">
                <ListView x:Name="List" MaxHeight="{x:Bind Model.ListMaxHeight, Mode=OneWay}" Padding="6,0,6,0"
                          ItemsSource="{x:Bind Model.VisibleTasks, Mode=OneWay}"
                          SelectedIndex="{x:Bind Model.SelectedIndex, Mode=TwoWay}"
                          SelectionMode="Single" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                          CanDragItems="{x:Bind Model.Editable, Mode=OneWay}"
                          CanReorderItems="{x:Bind Model.Editable, Mode=OneWay}"
                          AllowDrop="{x:Bind Model.Editable, Mode=OneWay}"
                          ItemContainerStyle="{StaticResource PlainRow}"
                          Visibility="{x:Bind Model.ShowingTasks, Mode=OneWay}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:TaskRow">
                        <Grid Padding="8,7,6,7" ColumnSpacing="10" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource Bare}" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                                    Click="Check_Click" Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}"
                                    IsEnabled="{x:Bind local:Row.Editable(IsDone), Mode=OneWay}">
                                <Grid>
                                    <Ellipse Width="17" Height="17" StrokeThickness="1.5" Stroke="{ThemeResource MutedTextBrush}" />
                                    <Ellipse Width="17" Height="17" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                             Visibility="{x:Bind local:Row.When(IsStriking), Mode=OneWay}" />
                                    <Ellipse Width="17" Height="17" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                             Visibility="{x:Bind local:Row.When(IsDone), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              Visibility="{x:Bind local:Row.When(IsStriking), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              Visibility="{x:Bind local:Row.When(IsDone), Mode=OneWay}" />
                                </Grid>
                            </Button>
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsPending, Mode=OneWay}" VerticalAlignment="Top" Margin="3,2,0,0"
                                          Visibility="{x:Bind IsPending, Mode=OneWay}" />

                            <StackPanel Grid.Column="1" Spacing="4" Opacity="{x:Bind local:Row.DoneFade(IsDone, IsStriking), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13.5" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           TextDecorations="{x:Bind local:Row.Strike(IsStriking), Mode=OneWay}"
                                           DoubleTapped="Title_DoubleTapped"
                                           Visibility="{x:Bind local:Row.Unless(IsEditing), Mode=OneWay}" />
                                <TextBox Visibility="{x:Bind local:Row.When(IsEditing), Mode=OneWay}" Loaded="Edit_Loaded"
                                         FontSize="13.5" Padding="6,3,6,3" MinHeight="0" />
                                <TextBlock Text="{x:Bind PendingText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource FaintTextBrush}"
                                           Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                <local:Accordion IsOpen="{x:Bind IsExpanded, Mode=OneWay}">
                                    <TextBox Text="{x:Bind Details, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="True"
                                             Foreground="{ThemeResource MutedTextBrush}" Margin="0,0,0,2"
                                             Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                             Loaded="Details_Loaded" />
                                </local:Accordion>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top"
                                        Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}">
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource FaintTextBrush}" Margin="0,0,4,0"
                                          Visibility="{x:Bind local:Row.When(HasDetails), Mode=OneWay}" />
                                <Button Style="{StaticResource Bare}" Padding="4,3,4,3" MinWidth="26" Click="Effort_Click"
                                        IsEnabled="{x:Bind local:Row.Editable(IsDone), Mode=OneWay}">
                                    <local:EffortChip Effort="{x:Bind Effort, Mode=OneWay}" />
                                </Button>
                                <Button Style="{StaticResource Bare}" Padding="4,3,4,3" Click="Priority_Click"
                                        IsEnabled="{x:Bind local:Row.Editable(IsDone), Mode=OneWay}">
                                    <local:PriorityBadge Priority="{x:Bind Priority, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>

                <Border x:Name="UndoPill" CornerRadius="16" Padding="14,6,6,6"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1"
                        Visibility="{x:Bind local:Row.When(Model.UndoVisible), Mode=OneWay}">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind Model.UndoText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" />
                        <Button Click="Undo_Click" Padding="10,3,10,4" CornerRadius="12" FontSize="12.5"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                <TextBlock Text="Undo" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <local:Welcome Grid.Row="5" Card="False"
                           Model="{x:Bind Model}"
                           Visibility="{x:Bind local:F.Both(Model.ShowEmptyHotkey, Model.ShowingTasks), Mode=OneWay}" />

            <Grid x:Name="SettingsHost" Grid.Row="6" Visibility="{x:Bind Model.SettingsOpen, Mode=OneWay}" />
        </Grid>

        <Grid x:Name="DockRoot" Height="44" Width="380" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" Visibility="Collapsed" PointerPressed="Dock_PointerPressed">
            <Grid Padding="14,0,16,0" ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="18" Height="18">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Visibility="{x:Bind local:F.NV(Model.IsProcessing), Mode=OneWay}" />
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind Model.IsProcessing, Mode=OneWay}"
                                  Visibility="{x:Bind Model.IsProcessing, Mode=OneWay}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="Capture a thought…" FontSize="13.5"
                           Foreground="{ThemeResource FaintTextBrush}" VerticalAlignment="Center"
                           Visibility="{x:Bind local:F.NV(Model.IsProcessing), Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="Interpreting…" FontSize="13.5"
                           Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"
                           Visibility="{x:Bind Model.IsProcessing, Mode=OneWay}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                Visibility="{x:Bind local:Row.WhenPositive(Model.OpenHighCount), Mode=OneWay}">
                        <local:PriorityBadge Priority="High" />
                        <TextBlock Text="{x:Bind local:Row.CountText(Model.OpenHighCount), Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                Visibility="{x:Bind local:Row.WhenPositive(Model.OpenMediumCount), Mode=OneWay}">
                        <local:PriorityBadge Priority="Medium" />
                        <TextBlock Text="{x:Bind local:Row.CountText(Model.OpenMediumCount), Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                Visibility="{x:Bind local:Row.WhenPositive(Model.OpenLowCount), Mode=OneWay}">
                        <local:PriorityBadge Priority="Low" />
                        <TextBlock Text="{x:Bind local:Row.CountText(Model.OpenLowCount), Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Visibility="{x:Bind local:Row.When(Model.Attention), Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
