<UserControl
    x:Class="TaskWidget.PriorityBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskWidget"
    Width="16"
    Height="16"
    AutomationProperties.Name="{x:Bind local:Row.PriorityTip(Priority), Mode=OneWay}"
    ToolTipService.ToolTip="{x:Bind local:Row.PriorityTip(Priority), Mode=OneWay}">
    <Grid>
        <Canvas Width="16" Height="16" Visibility="{x:Bind local:Row.WhenHigh(Priority), Mode=OneWay}">
            <Path Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z" Fill="{ThemeResource PriHighBrush}" />
            <Path Data="M8,4.6 V8.6" Stroke="{ThemeResource OnPriBrush}" StrokeThickness="1.9"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Width="2.2" Height="2.2" Fill="{ThemeResource OnPriBrush}" Canvas.Left="6.9" Canvas.Top="10.2" />
        </Canvas>
        <Canvas Width="16" Height="16" Visibility="{x:Bind local:Row.WhenMedium(Priority), Mode=OneWay}">
            <Path Data="M8,2.2 A5.8,5.8 0 1 1 7.99,2.2 Z" Stroke="{ThemeResource PriMediumBrush}" StrokeThickness="1.6" />
            <Path Data="M8,4.6 A3.4,3.4 0 0 1 8,11.4 Z" Fill="{ThemeResource PriMediumBrush}" />
        </Canvas>
        <Canvas Width="16" Height="16" Visibility="{x:Bind local:Row.WhenLow(Priority), Mode=OneWay}">
            <Path Data="M8,2.2 A5.8,5.8 0 1 1 7.99,2.2 Z" Stroke="{ThemeResource PriLowBrush}" StrokeThickness="1.6" />
        </Canvas>
    </Grid>
</UserControl>
