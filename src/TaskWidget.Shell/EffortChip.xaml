<UserControl
    x:Class="TaskWidget.EffortChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskWidget"
    VerticalAlignment="Center"
    AutomationProperties.Name="{x:Bind local:Row.EffortTip(Effort), Mode=OneWay}"
    ToolTipService.ToolTip="{x:Bind local:Row.EffortTip(Effort), Mode=OneWay}">
    <Border CornerRadius="9" Padding="7,1,7,2" Background="{ThemeResource ChipBrush}">
        <TextBlock Text="{x:Bind local:Row.EffortLabel(Effort), Mode=OneWay}" FontSize="11"
                   Foreground="{ThemeResource MutedTextBrush}" />
    </Border>
</UserControl>
