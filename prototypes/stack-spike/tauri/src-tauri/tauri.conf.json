{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpikeTauri",
  "version": "0.0.0",
  "identifier": "dev.taskwidget.spike",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Task Widget spike",
        "width": 380,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
