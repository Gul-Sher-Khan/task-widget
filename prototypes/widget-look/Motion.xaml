<!-- PROTOTYPE · Motion tokens. Binding for the implementation: copy this file. All durations in milliseconds.
     Easing curves are cubic-bezier control points (x1, y1, x2, y2):
       EaseOut (things arriving)  0.10, 0.90, 0.20, 1.00
       EaseIn  (things leaving)   0.40, 0.00, 1.00, 1.00
       Cubic out (window height, accordion) = 1 - (1 - t)^3
     List add/remove/reorder use WinUI's built-in ListView theme transitions (AddDelete, Reposition, Reorder). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="EaseOutX1">0.10</x:Double>
    <x:Double x:Key="EaseOutY1">0.90</x:Double>
    <x:Double x:Key="EaseOutX2">0.20</x:Double>
    <x:Double x:Key="EaseOutY2">1.00</x:Double>
    <x:Double x:Key="EaseInX1">0.40</x:Double>
    <x:Double x:Key="EaseInY1">0.00</x:Double>
    <x:Double x:Key="EaseInX2">1.00</x:Double>
    <x:Double x:Key="EaseInY2">1.00</x:Double>

    <!-- Widget window: grows/shrinks to fit its content (cubic out). -->
    <x:Double x:Key="WidgetGrowMs">200</x:Double>
    <x:Double x:Key="WidgetShrinkMs">170</x:Double>

    <!-- Dock -> Widget: window unrolls from 36 px to full height while the content fades in and slides down 10 px. -->
    <x:Double x:Key="WidgetUnrollMs">230</x:Double>
    <x:Double x:Key="WidgetContentInMs">260</x:Double>
    <!-- Widget -> Dock: content fades out and slides up 10 px, window rolls up to 36 px, then hides. -->
    <x:Double x:Key="WidgetContentOutMs">120</x:Double>
    <x:Double x:Key="WidgetRollUpMs">190</x:Double>
    <x:Double x:Key="WidgetSlidePx">10</x:Double>

    <!-- Dock appears: content fades in while scaling from 0.82 on a spring; disappears with a quick fade. -->
    <x:Double x:Key="DockInMs">220</x:Double>
    <x:Double x:Key="DockOutMs">110</x:Double>
    <x:Double x:Key="DockSpringFrom">0.82</x:Double>
    <x:Double x:Key="DockSpringDamping">0.62</x:Double>
    <x:Double x:Key="DockSpringPeriodMs">55</x:Double>

    <!-- Details accordion: height animates (cubic out), opacity follows. -->
    <x:Double x:Key="AccordionOpenMs">220</x:Double>
    <x:Double x:Key="AccordionCloseMs">170</x:Double>
    <x:Double x:Key="AccordionFadeInMs">260</x:Double>
    <x:Double x:Key="AccordionFadeOutMs">120</x:Double>

    <!-- Completing: the Task stays struck through this long (a second tick cancels), then animates out. -->
    <x:Double x:Key="StrikeHoldMs">1500</x:Double>

    <!-- Undo pill: rises 12 px and fades in, stays, then fades out. -->
    <x:Double x:Key="UndoInMs">260</x:Double>
    <x:Double x:Key="UndoFadeInMs">180</x:Double>
    <x:Double x:Key="UndoStayMs">5000</x:Double>
    <x:Double x:Key="UndoOutMs">150</x:Double>
    <x:Double x:Key="UndoRisePx">12</x:Double>
</ResourceDictionary>
