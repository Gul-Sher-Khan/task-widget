<!-- PROTOTYPE · Colour tokens. Binding for the implementation: copy this file.
     - Priority colours are fixed per theme and never use the accent.
     - The accent (WinUI's Accent* brushes) appears only on interactive bits: focus, caret, Capture box border, tick, attention dot.
     - HighContrast: every level uses the system text colour, so Priority is carried by the badge shape alone; no backdrop,
       no accent tints. WinUI selects this dictionary itself when Windows runs a contrast theme. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PriHighBrush" Color="#FF6A6E" />
            <SolidColorBrush x:Key="PriMediumBrush" Color="#F2B33D" />
            <SolidColorBrush x:Key="PriLowBrush" Color="#8FA3BF" />
            <SolidColorBrush x:Key="OnPriBrush" Color="#1B1B1F" />
            <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#202022" />
            <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ChipBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF6A6E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PriHighBrush" Color="#D13438" />
            <SolidColorBrush x:Key="PriMediumBrush" Color="#B7740A" />
            <SolidColorBrush x:Key="PriLowBrush" Color="#5C6F8A" />
            <SolidColorBrush x:Key="OnPriBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#F4F4F6" />
            <SolidColorBrush x:Key="CardBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="ChipBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14000000" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#99000000" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#66000000" />
            <SolidColorBrush x:Key="OkBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PriHighBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PriMediumBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PriLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnPriBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChipBrush" Color="Transparent" />
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="OkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- PROTOTYPE ONLY: an approximation of Windows' "Night sky" contrast theme, swapped over the Dark tokens by the
         control bar's "Contrast preview" so the look can be judged without changing Windows. WinUI's own controls are
         only partly affected; the real check is a Windows contrast theme (Settings › Accessibility › Contrast themes). -->
    <ResourceDictionary x:Key="ContrastPreview">
        <SolidColorBrush x:Key="PriHighBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PriMediumBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PriLowBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="OnPriBrush" Color="#000000" />
        <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#000000" />
        <SolidColorBrush x:Key="CardBrush" Color="#000000" />
        <SolidColorBrush x:Key="ChipBrush" Color="Transparent" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FaintTextBrush" Color="#A6A6A6" />
        <SolidColorBrush x:Key="OkBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D6B4FD" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#8080FF" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#33D6B4FD" />
        <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#55D6B4FD" />
    </ResourceDictionary>
</ResourceDictionary>
