<!-- PROTOTYPE · Settings, shown inside the Widget in place of the list. Connection: ChatGPT only (ADR 0003; round 4
     removed the API-key option), with a model override. Sign-in and the hotkey recorder are faked. -->
<UserControl
    x:Class="Look.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
            <Setter Property="Margin" Value="4,14,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10,12,12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource FaintTextBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" MaxHeight="520" Padding="12,0,12,4" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,0,8">

            <!-- Connection -->
            <TextBlock Text="Connection" Style="{StaticResource Section}" Margin="4,4,0,6" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <!-- ChatGPT, signed in -->
                    <StackPanel Spacing="10" Visibility="{x:Bind P.SignedIn, Mode=OneWay}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="G" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind P.Account}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind P.Plan}" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Sign out" Click="SignOut_Click" Padding="10,4,10,5" FontSize="12.5" />
                        </Grid>
                        <ComboBox Header="Model" ItemsSource="{x:Bind Models}" SelectedIndex="{x:Bind P.Model, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" FontSize="13" />
                    </StackPanel>

                    <!-- ChatGPT, signed out: ROUND 4 · the shared sign-in flow -->
                    <StackPanel Spacing="8" Visibility="{x:Bind P.SignedOut, Mode=OneWay}">
                        <TextBlock Text="Not signed in" FontSize="13" />
                        <local:SignInBlock />
                        <TextBlock Style="{StaticResource Caption}" Text="Opens your browser. Task Widget never sees your password." />
                    </StackPanel>

                    <!-- ROUND 4 · ChatGPT is the only Connection (ADR 0003); the caption adds the privacy line -->
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Captures use your ChatGPT plan. Automatic picks the fastest model your plan offers. Only what you capture and today's date are sent to ChatGPT. Nothing else leaves this PC." />
                </StackPanel>
            </Border>

            <!-- Hotkey -->
            <TextBlock Text="Hotkey" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Open and add a Capture" FontSize="13" />
                            <TextBlock Text="Tap to open, tap again to add" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="Record_Click" Padding="8,4,8,5" MinWidth="120" x:Name="RecordButton">
                            <Grid>
                                <TextBlock Text="{x:Bind P.Hotkey, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                           Visibility="{x:Bind P.NotRecording, Mode=OneWay}" />
                                <TextBlock Text="Press keys…" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind P.Recording, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="A modifier pair (like Ctrl + Shift) fires on a tap: press both, release, no other key. Some keyboards use Ctrl + Shift to switch language." />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <ComboBox Header="Theme" ItemsSource="{x:Bind Themes}" SelectedIndex="{x:Bind P.Theme, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="13" />
                    <ComboBox Header="Backdrop" ItemsSource="{x:Bind Backdrops}" SelectedIndex="{x:Bind P.Backdrop, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="13" />
                    <TextBlock Style="{StaticResource Caption}" Visibility="{x:Bind TransparencyOff}"
                               Text="Windows transparency effects are off, so every backdrop shows as Solid." />
                </StackPanel>
            </Border>

            <!-- Widget -->
            <TextBlock Text="Widget" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="Rows before scrolling" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind local:F.Count(P.MaxRows), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider Minimum="4" Maximum="15" StepFrequency="1" Value="{x:Bind P.MaxRowsD, Mode=TwoWay}" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Start with Windows" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch IsOn="{x:Bind P.LaunchAtLogin, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      HorizontalAlignment="Right" Margin="0,0,-12,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind P.VersionLine, Mode=OneWay}" FontSize="13" />
                            <TextBlock Text="Open source, MIT" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <!-- ROUND 4 · About links to the README's Privacy section -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <HyperlinkButton Content="Privacy" FontSize="12.5" NavigateUri="https://github.com/Gul-Sher-Khan/task-widget#privacy" />
                            <HyperlinkButton Content="GitHub" FontSize="12.5" NavigateUri="https://github.com/Gul-Sher-Khan/task-widget" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource HairlineBrush}" Margin="-12,0" />

                    <!-- Up to date / couldn't check: status on the left, Check now on the right -->
                    <Grid Visibility="{x:Bind P.CanCheck, Mode=OneWay}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="You're up to date" FontSize="13" Visibility="{x:Bind P.UpdCurrent, Mode=OneWay}" />
                            <TextBlock Text="Couldn't check for updates" FontSize="13" Foreground="{ThemeResource ErrorBrush}"
                                       Visibility="{x:Bind P.UpdFailed, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind P.CheckedWhen, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Check now" Click="CheckNow_Click" Padding="10,4,10,5" FontSize="12.5" />
                    </Grid>

                    <!-- Checking -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind P.UpdChecking, Mode=OneWay}" MinHeight="32">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind P.UpdChecking, Mode=OneWay}" />
                        <TextBlock Text="Checking for updates…" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Update available: what's new, then one click downloads, runs the installer and restarts -->
                    <Grid Visibility="{x:Bind P.UpdAvailable, Mode=OneWay}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13">
                                <Run Text="Version" /> <Run Text="{x:Bind P.NewVersion}" FontWeight="SemiBold" /> <Run Text="is available" />
                            </TextBlock>
                            <HyperlinkButton Content="What's new" FontSize="11.5" Padding="0,1,0,2"
                                             NavigateUri="https://github.com/Gul-Sher-Khan/task-widget/releases" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Update" Click="Install_Click" Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,4,12,5" FontSize="12.5" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Downloading the installer -->
                    <StackPanel Spacing="6" Visibility="{x:Bind P.UpdDownloading, Mode=OneWay}">
                        <TextBlock FontSize="13">
                            <Run Text="Downloading" /> <Run Text="{x:Bind P.NewVersion}" /><Run Text="…" />
                        </TextBlock>
                        <ProgressBar Maximum="1" Value="{x:Bind P.Downloaded, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Task Widget restarts to finish. Your Tasks and draft are kept." />
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="Check for updates automatically" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch IsOn="{x:Bind P.AutoUpdate, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      HorizontalAlignment="Right" Margin="0,0,-12,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Once a day, Task Widget asks GitHub for the latest version. Nothing about you or your Tasks is sent. Updates never install without you." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
