<!-- PROTOTYPE · The Widget ("Fluent list", chosen in round 1): header, Capture box on top, flat rows with a Priority icon
     and an Effort icon. The gear swaps the list for the Settings panel.
     ROUND 4 adds (marked below; variant A was picked): header banner, welcome card / hotkey-only empty
     state, "Waiting for dictation…", waiting and failed rows (CaptureRow), Re-interpret dimming, read-only rows. -->
<UserControl
    x:Class="Look.WidgetA"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look"
    Width="360">
    <Grid Padding="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="16,10,8,4" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind P.ShowTasks, Mode=OneWay}">
                <TextBlock Text="Tasks" FontSize="15" FontWeight="SemiBold" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}" />
                <TextBlock Text="Done" FontSize="15" FontWeight="SemiBold" Visibility="{x:Bind S.ShowDone, Mode=OneWay}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountOpen), Mode=OneWay}" Foreground="{ThemeResource FaintTextBrush}"
                           FontSize="13" VerticalAlignment="Center" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="-8,0,0,0" Visibility="{x:Bind P.ShowSettings, Mode=OneWay}">
                <Button Style="{StaticResource Bare}" Width="30" Height="30" Click="Settings_Click" ToolTipService.ToolTip="Back to Tasks">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Bare}" Width="30" Height="30" Click="Resort_Click"
                    ToolTipService.ToolTip="Re-sort by Priority and Effort"
                    Visibility="{x:Bind local:F.All3(S.Manual, S.ShowingOpen, P.ShowTasks), Mode=OneWay}">
                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Bare}" Width="30" Height="30" Click="Done_Click"
                    ToolTipService.ToolTip="Done view" Visibility="{x:Bind P.ShowTasks, Mode=OneWay}">
                <Grid>
                    <FontIcon Glyph="&#xE81C;" FontSize="14" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE72B;" FontSize="14" Visibility="{x:Bind S.ShowDone, Mode=OneWay}" />
                </Grid>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource Bare}" Width="30" Height="30" Click="Settings_Click"
                    ToolTipService.ToolTip="Settings" Visibility="{x:Bind P.ShowTasks, Mode=OneWay}">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Bare}" Width="30" Height="30" Click="Collapse_Click"
                    ToolTipService.ToolTip="Collapse to the Dock">
                <FontIcon Glyph="&#xE70E;" FontSize="13" />
            </Button>
        </Grid>

        <!-- ROUND 4 · banner: a tinted strip under the header -->
        <local:BannerView Grid.Row="1" Visibility="{x:Bind P.HasBanner, Mode=OneWay}" local:Fx.Enter="True" />

        <!-- Capture box -->
        <Grid Grid.Row="2" Margin="12,4,12,6" Visibility="{x:Bind local:F.Both(S.ShowingOpen, P.ShowTasks), Mode=OneWay}">
            <TextBox x:Name="Capture" MinHeight="36" Padding="10,7,10,6" CornerRadius="6"
                     PlaceholderText="{x:Bind local:F.CapturePlaceholder(P.WaitingDictation), Mode=OneWay}" FontSize="13.5"
                     ToolTipService.ToolTip="{x:Bind local:F.ReadOnlyTip(P.ReadOnly), Mode=OneWay}" />

            <!-- ROUND 4 · read-only (saved by a newer version): typing a draft works, committing doesn't -->
            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource FaintTextBrush}" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" Visibility="{x:Bind P.ReadOnly, Mode=OneWay}" />

            <!-- ROUND 4 · "Waiting for dictation…": the placeholder changes and a thin indeterminate bar runs under the box -->
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom" Margin="6,0,6,0" IsHitTestVisible="False"
                         Visibility="{x:Bind P.WaitingDictation, Mode=OneWay}" />
        </Grid>

        <!-- ROUND 4 · welcome card (first run, before the first sign-in) -->
        <local:Welcome Grid.Row="3" Card="True" local:Fx.Enter="True"
                       Visibility="{x:Bind local:F.WelcomeV(P.ShowWelcome, S.ShowingOpen, P.ShowTasks), Mode=OneWay}" />

        <!-- Tasks -->
        <ListView x:Name="List" Grid.Row="4" MaxHeight="{x:Bind P.ListMaxHeight, Mode=OneWay}" Padding="6,0,6,0"
                  ItemsSource="{x:Bind S.Visible, Mode=OneWay}" ItemContainerStyle="{StaticResource PlainRow}"
                  CanDragItems="{x:Bind local:F.Both2(S.ShowingOpen, P.Editable), Mode=OneWay}"
                  CanReorderItems="{x:Bind local:F.Both2(S.ShowingOpen, P.Editable), Mode=OneWay}"
                  AllowDrop="{x:Bind local:F.Both2(S.ShowingOpen, P.Editable), Mode=OneWay}" Visibility="{x:Bind P.ShowTasks, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TaskVm">
                    <Grid>
                    <!-- ROUND 4 · Re-interpret dims the Capture's old Tasks (fade over DimMs) -->
                    <Grid Padding="8,7,6,7" ColumnSpacing="10" Background="Transparent" Visibility="{x:Bind IsTaskRow, Mode=OneWay}"
                          Opacity="{x:Bind local:F.Dim(IsDimmed), Mode=OneWay}" local:Fx.DimFade="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- tick -->
                        <Button Style="{StaticResource Bare}" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                                Click="Check_Click" Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}" IsEnabled="{x:Bind local:F.Editable(IsDone), Mode=OneWay}">
                            <Grid>
                                <Ellipse Width="17" Height="17" StrokeThickness="1.5" Stroke="{ThemeResource MutedTextBrush}" />
                                <Ellipse Width="17" Height="17" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind IsStriking, Mode=OneWay}" />
                                <Ellipse Width="17" Height="17" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                          Visibility="{x:Bind IsStriking, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                          Visibility="{x:Bind IsDone, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsPending, Mode=OneWay}" VerticalAlignment="Top" Margin="3,2,0,0"
                                      Visibility="{x:Bind IsPending, Mode=OneWay}" />

                        <!-- title + details -->
                        <StackPanel Grid.Column="1" Spacing="4" Opacity="{x:Bind local:F.DoneFade(IsDone, IsStriking), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13.5" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" TextDecorations="{x:Bind local:F.Strike(IsStriking), Mode=OneWay}"
                                       DoubleTapped="Title_DoubleTapped"
                                       Visibility="{x:Bind local:F.NV(IsEditing), Mode=OneWay}" />
                            <TextBox Visibility="{x:Bind IsEditing, Mode=OneWay}" Loaded="Edit_Loaded" FontSize="13.5"
                                     Padding="6,3,6,3" MinHeight="0" />
                            <TextBlock Text="{x:Bind PendingText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource FaintTextBrush}"
                                       Visibility="{x:Bind IsPending, Mode=OneWay}" />
                            <local:Accordion IsOpen="{x:Bind IsExpanded, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{ThemeResource MutedTextBrush}" Margin="0,0,0,2" />
                            </local:Accordion>
                        </StackPanel>

                        <!-- Priority + Effort -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top"
                                    Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}">
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource FaintTextBrush}" Margin="0,0,4,0"
                                      Visibility="{x:Bind HasDetails, Mode=OneWay}" />
                            <Button Style="{StaticResource Bare}" Padding="4,3,4,3" Click="Eff_Click" MinWidth="26" IsEnabled="{x:Bind local:F.Editable(IsDone), Mode=OneWay}">
                                <local:EffIcon Effort="{x:Bind Effort, Mode=OneWay}" />
                            </Button>
                            <Button Style="{StaticResource Bare}" Padding="4,3,4,3" Click="Pri_Click" IsEnabled="{x:Bind local:F.Editable(IsDone), Mode=OneWay}">
                                <local:PriIcon Priority="{x:Bind Priority, Mode=OneWay}" />
                            </Button>
                        </StackPanel>                    </Grid>

                    <!-- ROUND 4 · waiting / failed / editing a Capture -->
                    <local:CaptureRow Item="{x:Bind}" Visibility="{x:Bind IsCaptureRow, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ROUND 4 · the empty list after sign-in shows only the hotkey line (replaces "All clear.") -->
        <local:Welcome Grid.Row="5" Card="False"
                       Visibility="{x:Bind local:F.EmptyHint(S.IsEmpty, P.ShowWelcome, S.ShowingOpen, P.ShowTasks), Mode=OneWay}" />

        <!-- Settings -->
        <local:SettingsPanel x:Name="SettingsView" Grid.Row="6" Visibility="{x:Bind P.ShowSettings, Mode=OneWay}" />

        <local:UndoPill Grid.Row="4" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
    </Grid>
</UserControl>
