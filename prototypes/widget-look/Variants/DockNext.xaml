<!-- PROTOTYPE · Dock "Next up": the top-ranked Task, tickable right here, then how many more are waiting. Clicking anywhere
     else opens the Widget. An accent bar sweeps along the bottom while a Capture is processing. -->
<UserControl
    x:Class="Look.DockNext"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid Height="44" Background="Transparent">
        <Grid Padding="10,0,10,0" ColumnSpacing="10" VerticalAlignment="Center" Visibility="{x:Bind local:F.NV(S.AllClear), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Bare}" Width="26" Height="26" CornerRadius="13" Click="Tick_Click" ToolTipService.ToolTip="Mark done">
                <Grid>
                    <Ellipse Width="18" Height="18" StrokeThickness="1.5" Stroke="{ThemeResource MutedTextBrush}" />
                    <Ellipse Width="18" Height="18" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind Striking, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="{x:Bind Striking, Mode=OneWay}" />
                </Grid>
            </Button>
            <local:PriIcon x:Name="Pri" Grid.Column="1" />
            <TextBlock Grid.Column="2" Text="{x:Bind TopTitle, Mode=OneWay}" FontSize="13.5" MaxWidth="250" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" TextDecorations="{x:Bind local:F.Strike(Striking), Mode=OneWay}" />
            <local:EffIcon x:Name="Eff" Grid.Column="3" />
            <Border Grid.Column="4" CornerRadius="10" Padding="8,2,8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="{x:Bind local:F.VN(S.OthersCount), Mode=OneWay}" ToolTipService.ToolTip="More open Tasks">
                <TextBlock Text="{x:Bind local:F.Plus(S.OthersCount), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
            </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,0,18,0" VerticalAlignment="Center" Visibility="{x:Bind S.AllClear, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="All clear" FontSize="13.5" Foreground="{ThemeResource MutedTextBrush}" />
        </StackPanel>
        <Canvas VerticalAlignment="Bottom" Height="2" Margin="14,0,14,4">
            <Rectangle x:Name="Bar" Width="28" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Canvas>
        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind S.Attention, Mode=OneWay}" />
    </Grid>
</UserControl>
