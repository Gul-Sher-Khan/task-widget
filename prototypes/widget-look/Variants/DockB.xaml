<!-- PROTOTYPE · Dock B: a tab hanging from the top edge (its top corners sit off-screen). Count inside a Priority-coloured
     disc; an accent bar sweeps along the bottom while a Capture is processing. -->
<UserControl
    x:Class="Look.DockB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,14,16,8" HorizontalAlignment="Center">
            <Grid Width="24" Height="24" Visibility="{x:Bind local:F.VN(S.CountHigh), Mode=OneWay}">
                <Ellipse Fill="{x:Bind local:F.PriBy('High')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountHigh), Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
            </Grid>
            <Grid Width="24" Height="24" Visibility="{x:Bind local:F.VN(S.CountMedium), Mode=OneWay}">
                <Ellipse Fill="{x:Bind local:F.PriBy('Medium')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountMedium), Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#1A1300"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
            </Grid>
            <Grid Width="24" Height="24" Visibility="{x:Bind local:F.VN(S.CountLow), Mode=OneWay}">
                <Ellipse Fill="{x:Bind local:F.PriBy('Low')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountLow), Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
            </Grid>
            <Grid Width="24" Height="24" Visibility="{x:Bind S.AllClear, Mode=OneWay}">
                <Ellipse Stroke="{ThemeResource FaintTextBrush}" StrokeThickness="1.5" />
                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource FaintTextBrush}" />
            </Grid>
        </StackPanel>
        <Canvas VerticalAlignment="Bottom" Height="2" Margin="12,0,12,3">
            <Rectangle x:Name="Bar" Width="24" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Canvas>
        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,5,0"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind S.Attention, Mode=OneWay}" />
    </Grid>
</UserControl>
