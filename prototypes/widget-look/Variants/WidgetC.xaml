<!-- PROTOTYPE · Variant C "Next up": the Capture box is the top bar; the first Task is a large hero with its Details
     showing; everything after it is a dense one-liner with a shape glyph and Effort dots. -->
<UserControl
    x:Class="Look.WidgetC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look"
    Width="340">
    <UserControl.Resources>
        <Style x:Key="BarBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>
    <Grid Padding="0,0,0,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: Capture box + tools -->
        <Grid Padding="6,6,6,4" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Capture" Style="{StaticResource BarBox}" FontSize="15" Padding="10,8,8,8" MinHeight="40"
                     PlaceholderText="What's on your mind?" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}" />
            <TextBlock Text="Done" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"
                       Visibility="{x:Bind S.ShowDone, Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <Button Style="{StaticResource Bare}" Width="28" Height="28" Click="Resort_Click" ToolTipService.ToolTip="Re-sort"
                        Visibility="{x:Bind local:F.Both(S.Manual, S.ShowingOpen), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource Bare}" Width="28" Height="28" Click="Done_Click" ToolTipService.ToolTip="Done view">
                    <Grid>
                        <FontIcon Glyph="&#xE81C;" FontSize="13" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Visibility="{x:Bind S.ShowDone, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Bare}" Width="28" Height="28" Click="Collapse_Click" ToolTipService.ToolTip="Collapse to the Dock">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource HairlineBrush}" />

        <ListView x:Name="List" Grid.Row="1" MaxHeight="400" Padding="4,4,4,0"
                  ItemsSource="{x:Bind S.Visible, Mode=OneWay}" ItemContainerStyle="{StaticResource PlainRow}"
                  CanDragItems="{x:Bind S.ShowingOpen, Mode=OneWay}" CanReorderItems="{x:Bind S.ShowingOpen, Mode=OneWay}"
                  AllowDrop="{x:Bind S.ShowingOpen, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TaskVm">
                    <Grid Background="Transparent">
                        <!-- Hero: the first open Task -->
                        <Grid Visibility="{x:Bind IsFirst, Mode=OneWay}" Padding="12,10,10,12" Margin="0,2,0,6" CornerRadius="8"
                              Background="{x:Bind local:F.PriSoft(Priority), Mode=OneWay}">
                            <StackPanel Spacing="6" Opacity="{x:Bind local:F.Fade(IsStriking), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="{x:Bind local:F.PriShape(Priority), Mode=OneWay}" Fill="{x:Bind local:F.Pri(Priority), Mode=OneWay}" />
                                    <TextBlock Text="NEXT UP" FontSize="10.5" FontWeight="Bold" CharacterSpacing="80"
                                               Foreground="{x:Bind local:F.Pri(Priority), Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                           TextDecorations="{x:Bind local:F.Strike(IsStriking), Mode=OneWay}"
                                           DoubleTapped="Title_DoubleTapped" Visibility="{x:Bind local:F.NV(IsEditing), Mode=OneWay}" />
                                <TextBox Visibility="{x:Bind IsEditing, Mode=OneWay}" Loaded="Edit_Loaded" FontSize="16" Padding="6,3,6,3" MinHeight="0" />
                                <TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}"
                                           Visibility="{x:Bind HasDetails, Mode=OneWay}" />
                                <Grid Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="-6,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Bare}" Padding="6,3,6,3" Click="Pri_Click">
                                            <TextBlock Text="{x:Bind local:F.PriWord(Priority), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        </Button>
                                        <Button Style="{StaticResource Bare}" Padding="6,3,6,3" Click="Eff_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <Ellipse Width="5" Height="5" Fill="{ThemeResource MutedTextBrush}" Opacity="{x:Bind local:F.EffDot(Effort, 0), Mode=OneWay}" />
                                                <Ellipse Width="5" Height="5" Fill="{ThemeResource MutedTextBrush}" Opacity="{x:Bind local:F.EffDot(Effort, 1), Mode=OneWay}" />
                                                <Ellipse Width="5" Height="5" Fill="{ThemeResource MutedTextBrush}" Opacity="{x:Bind local:F.EffDot(Effort, 2), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind local:F.EffWord(Effort), Mode=OneWay}" FontSize="12" Margin="4,0,0,0" Foreground="{ThemeResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Click="Check_Click" Padding="12,4,12,5" CornerRadius="14"
                                            Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                            <TextBlock Text="Done" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Compact row -->
                        <Grid Visibility="{x:Bind local:F.NV(IsFirst), Mode=OneWay}" Padding="10,5,8,5" ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Bare}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0" Click="Check_Click"
                                    Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}" ToolTipService.ToolTip="Tick">
                                <Grid>
                                    <Path Width="10" Height="10" Stretch="Uniform" Data="{x:Bind local:F.PriShape2(Priority), Mode=OneWay}"
                                          Fill="{x:Bind local:F.Pri(Priority), Mode=OneWay}" Visibility="{x:Bind local:F.NV(IsStriking), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{x:Bind IsStriking, Mode=OneWay}" />
                                </Grid>
                            </Button>
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsPending, Mode=OneWay}" Visibility="{x:Bind IsPending, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Spacing="4" Opacity="{x:Bind local:F.DoneFade(IsDone, IsStriking), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           TextDecorations="{x:Bind local:F.Strike(IsStriking), Mode=OneWay}"
                                           DoubleTapped="Title_DoubleTapped" Visibility="{x:Bind local:F.NV(IsEditing), Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox Visibility="{x:Bind IsEditing, Mode=OneWay}" Loaded="Edit_Loaded" FontSize="13" Padding="6,2,6,2" MinHeight="0" />
                                <local:Accordion IsOpen="{x:Bind IsExpanded, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" />
                                </local:Accordion>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Bare}" Padding="4,5,4,5" VerticalAlignment="Top" Click="Eff_Click"
                                    Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind local:F.EffWord(Effort), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="4" Height="4" Fill="{ThemeResource MutedTextBrush}" Opacity="{x:Bind local:F.EffDot(Effort, 0), Mode=OneWay}" />
                                    <Ellipse Width="4" Height="4" Fill="{ThemeResource MutedTextBrush}" Opacity="{x:Bind local:F.EffDot(Effort, 1), Mode=OneWay}" />
                                    <Ellipse Width="4" Height="4" Fill="{ThemeResource MutedTextBrush}" Opacity="{x:Bind local:F.EffDot(Effort, 2), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Text="Nothing next. Enjoy it." HorizontalAlignment="Center" Margin="0,22,0,22"
                   Foreground="{ThemeResource FaintTextBrush}" Visibility="{x:Bind local:F.Both(S.AllClear, S.ShowingOpen), Mode=OneWay}" />

        <local:UndoPill Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
    </Grid>
</UserControl>
