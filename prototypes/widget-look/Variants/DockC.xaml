<!-- PROTOTYPE · Dock C: a compact cluster in the top-right corner. Large Priority shapes with the count as a small
     badge; the shapes bob in turn while a Capture is processing. -->
<UserControl
    x:Class="Look.DockC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,8,14,7">
            <Grid x:Name="G0" Width="24" Height="22" Visibility="{x:Bind local:F.VN(S.CountHigh), Mode=OneWay}">
                <Path Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Fill="{x:Bind local:F.PriBy('High')}" Data="{x:Bind local:F.ShapeBy('High')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountHigh), Mode=OneWay}" FontSize="10.5" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
            <Grid x:Name="G1" Width="24" Height="22" Visibility="{x:Bind local:F.VN(S.CountMedium), Mode=OneWay}">
                <Path Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Fill="{x:Bind local:F.PriBy('Medium')}" Data="{x:Bind local:F.ShapeBy('Medium')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountMedium), Mode=OneWay}" FontSize="10.5" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
            <Grid x:Name="G2" Width="24" Height="22" Visibility="{x:Bind local:F.VN(S.CountLow), Mode=OneWay}">
                <Path Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Fill="{x:Bind local:F.PriBy('Low')}" Data="{x:Bind local:F.ShapeBy('Low')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountLow), Mode=OneWay}" FontSize="10.5" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource FaintTextBrush}" Visibility="{x:Bind S.AllClear, Mode=OneWay}" />
        </StackPanel>
        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind S.Attention, Mode=OneWay}" />
    </Grid>
</UserControl>
