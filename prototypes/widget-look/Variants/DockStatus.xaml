<!-- PROTOTYPE · Dock "Status pill": Priority icons with counts, then a ring showing today's progress (Done today out of
     Done today + open) with the Done count. An accent bar sweeps along the bottom while a Capture is processing. -->
<UserControl
    x:Class="Look.DockStatus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid Height="44" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="16" Padding="18,0,20,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind local:F.VN(S.CountHigh), Mode=OneWay}">
                <local:PriIcon Priority="High" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountHigh), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind local:F.VN(S.CountMedium), Mode=OneWay}">
                <local:PriIcon Priority="Medium" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountMedium), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind local:F.VN(S.CountLow), Mode=OneWay}">
                <local:PriIcon Priority="Low" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountLow), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <Rectangle Width="1" Height="18" Fill="{ThemeResource HairlineBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="7" ToolTipService.ToolTip="Done today">
                <Grid Width="20" Height="20">
                    <ProgressRing IsIndeterminate="False" Value="{x:Bind local:F.Pct(S.DayProgress), Mode=OneWay}" Width="20" Height="20"
                                  Background="{ThemeResource HairlineBrush}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <TextBlock Text="{x:Bind local:F.Count(S.DoneToday), Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </StackPanel>
        <Canvas VerticalAlignment="Bottom" Height="2" Margin="14,0,14,4">
            <Rectangle x:Name="Bar" Width="28" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Canvas>
        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind S.Attention, Mode=OneWay}" />
    </Grid>
</UserControl>
