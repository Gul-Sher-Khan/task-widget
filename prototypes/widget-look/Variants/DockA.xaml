<!-- PROTOTYPE · Dock A: a small floating bar centred just under the top edge. Shape + count per Priority, no text. -->
<UserControl
    x:Class="Look.DockA"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid Background="Transparent">
        <StackPanel x:Name="Icons" Orientation="Horizontal" Spacing="16" Padding="16,7,18,8" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:F.VN(S.CountHigh), Mode=OneWay}">
                <Path Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Fill="{x:Bind local:F.PriBy('High')}"
                      Data="{x:Bind local:F.ShapeBy('High')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountHigh), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:F.VN(S.CountMedium), Mode=OneWay}">
                <Path Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Fill="{x:Bind local:F.PriBy('Medium')}"
                      Data="{x:Bind local:F.ShapeBy('Medium')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountMedium), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:F.VN(S.CountLow), Mode=OneWay}">
                <Path Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Fill="{x:Bind local:F.PriBy('Low')}"
                      Data="{x:Bind local:F.ShapeBy('Low')}" />
                <TextBlock Text="{x:Bind local:F.Count(S.CountLow), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource FaintTextBrush}"
                      Visibility="{x:Bind S.AllClear, Mode=OneWay}" />
        </StackPanel>
        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind S.Attention, Mode=OneWay}" />
    </Grid>
</UserControl>
