<!-- PROTOTYPE · Variant B "Cards": each Task a card with a Priority band and a pie-clock Effort; Capture box at the bottom
     as a composer; header shows per-Priority counts. -->
<UserControl
    x:Class="Look.WidgetB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look"
    Width="380">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: counts by Priority -->
        <Grid Padding="14,10,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}">
                <Border CornerRadius="10" Padding="8,2,9,3" Background="{x:Bind local:F.PriSoftBy('High')}" Visibility="{x:Bind local:F.VN(S.CountHigh), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" Fill="{x:Bind local:F.PriBy('High')}" Data="{x:Bind local:F.ShapeBy('High')}" />
                        <TextBlock Text="{x:Bind local:F.Count(S.CountHigh), Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind local:F.PriBy('High')}" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="8,2,9,3" Background="{x:Bind local:F.PriSoftBy('Medium')}" Visibility="{x:Bind local:F.VN(S.CountMedium), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" Fill="{x:Bind local:F.PriBy('Medium')}" Data="{x:Bind local:F.ShapeBy('Medium')}" />
                        <TextBlock Text="{x:Bind local:F.Count(S.CountMedium), Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind local:F.PriBy('Medium')}" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="8,2,9,3" Background="{x:Bind local:F.PriSoftBy('Low')}" Visibility="{x:Bind local:F.VN(S.CountLow), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" Fill="{x:Bind local:F.PriBy('Low')}" Data="{x:Bind local:F.ShapeBy('Low')}" />
                        <TextBlock Text="{x:Bind local:F.Count(S.CountLow), Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind local:F.PriBy('Low')}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="Done" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{x:Bind S.ShowDone, Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource Bare}" Width="30" Height="30" Click="Resort_Click" ToolTipService.ToolTip="Re-sort"
                        Visibility="{x:Bind local:F.Both(S.Manual, S.ShowingOpen), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource Bare}" Width="30" Height="30" Click="Done_Click" ToolTipService.ToolTip="Done view">
                    <Grid>
                        <FontIcon Glyph="&#xE81C;" FontSize="14" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Visibility="{x:Bind S.ShowDone, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Bare}" Width="30" Height="30" Click="Collapse_Click" ToolTipService.ToolTip="Collapse to the Dock">
                    <FontIcon Glyph="&#xE70E;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Cards -->
        <ListView x:Name="List" Grid.Row="1" MaxHeight="430" Padding="10,0,10,0"
                  ItemsSource="{x:Bind S.Visible, Mode=OneWay}" ItemContainerStyle="{StaticResource PlainRow}"
                  CanDragItems="{x:Bind S.ShowingOpen, Mode=OneWay}" CanReorderItems="{x:Bind S.ShowingOpen, Mode=OneWay}"
                  AllowDrop="{x:Bind S.ShowingOpen, Mode=OneWay}">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TaskVm">
                    <Border Margin="0,3,0,3" CornerRadius="8" Background="{ThemeResource CardBrush}"
                            BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="10" Padding="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{x:Bind local:F.Pri(Priority), Mode=OneWay}" Opacity="{x:Bind local:F.Fade(IsPending), Mode=OneWay}" />

                            <Button Grid.Column="1" Style="{StaticResource Bare}" Width="24" Height="24" CornerRadius="6" Margin="0,10,0,0"
                                    VerticalAlignment="Top" Click="Check_Click" Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}">
                                <Grid>
                                    <Border Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{ThemeResource MutedTextBrush}" />
                                    <Border Width="18" Height="18" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsStriking, Mode=OneWay}" />
                                    <Border Width="18" Height="18" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="{x:Bind IsStriking, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                </Grid>
                            </Button>
                            <ProgressRing Grid.Column="1" Width="18" Height="18" Margin="3,12,0,0" VerticalAlignment="Top"
                                          IsActive="{x:Bind IsPending, Mode=OneWay}" Visibility="{x:Bind IsPending, Mode=OneWay}" />

                            <StackPanel Grid.Column="2" Padding="0,10,0,10" Spacing="6" Opacity="{x:Bind local:F.DoneFade(IsDone, IsStriking), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="CharacterEllipsis" TextDecorations="{x:Bind local:F.Strike(IsStriking), Mode=OneWay}"
                                           DoubleTapped="Title_DoubleTapped" Visibility="{x:Bind local:F.NV(IsEditing), Mode=OneWay}" />
                                <TextBox Visibility="{x:Bind IsEditing, Mode=OneWay}" Loaded="Edit_Loaded" FontSize="14" Padding="6,3,6,3" MinHeight="0" />

                                <!-- meta line -->
                                <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind local:F.NV(IsPending), Mode=OneWay}" Margin="-6,0,0,0">
                                    <Button Style="{StaticResource Bare}" Padding="6,2,6,2" Click="Pri_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                                                  Data="{x:Bind local:F.PriShape(Priority), Mode=OneWay}" Fill="{x:Bind local:F.Pri(Priority), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind local:F.PriWord(Priority), Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Bare}" Padding="6,2,6,2" Click="Eff_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                <Ellipse Stroke="{ThemeResource MutedTextBrush}" StrokeThickness="1.2" />
                                                <Path Data="{x:Bind local:F.EffPie(Effort), Mode=OneWay}" Fill="{ThemeResource MutedTextBrush}" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind local:F.EffSpan(Effort), Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <FontIcon Glyph="&#xE8BD;" FontSize="11" Margin="6,1,0,0" Foreground="{ThemeResource FaintTextBrush}"
                                              Visibility="{x:Bind HasDetails, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="Turning this into Tasks…" FontSize="11.5" Foreground="{ThemeResource FaintTextBrush}"
                                           Visibility="{x:Bind IsPending, Mode=OneWay}" />

                                <local:Accordion IsOpen="{x:Bind IsExpanded, Mode=OneWay}">
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource HairlineBrush}" Padding="0,8,0,0">
                                        <TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource MutedTextBrush}" />
                                    </Border>
                                </local:Accordion>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Text="Nothing on your plate." HorizontalAlignment="Center" Margin="0,24,0,24"
                   Foreground="{ThemeResource FaintTextBrush}" Visibility="{x:Bind local:F.Both(S.AllClear, S.ShowingOpen), Mode=OneWay}" />

        <!-- Composer -->
        <Grid Grid.Row="2" Padding="10,8,10,10" Visibility="{x:Bind S.ShowingOpen, Mode=OneWay}">
            <TextBox x:Name="Capture" MinHeight="40" Padding="14,10,40,9" CornerRadius="20" FontSize="13.5"
                     PlaceholderText="Say or type what's on your mind" />
            <Button Style="{StaticResource Bare}" Width="30" Height="30" CornerRadius="15" Margin="0,0,5,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Send_Click" ToolTipService.ToolTip="Add (Enter)">
                <FontIcon Glyph="&#xE724;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Button>
        </Grid>

        <local:UndoPill Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60" />
    </Grid>
</UserControl>
