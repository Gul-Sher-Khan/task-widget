<!-- PROTOTYPE · ROUND 4 · The one sign-in flow, shown the same on the welcome card and in Settings › Connection.
     States (from "First run, sign-in and privacy disclosure"): idle, waiting for the browser + Cancel,
     "Sign-in didn't finish" + Try again (cause in a tooltip), plan not eligible.
     A: the button is swapped in place for a quiet status line.  B: the button keeps its place and an InfoBar reports.
     C: a pill that morphs, with the status as a caption above it. -->
<UserControl
    x:Class="Look.SignInBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid>
        <!-- A · Quiet -->
        <StackPanel Spacing="8" Visibility="{x:Bind P.VA}">
            <StackPanel Spacing="0" Visibility="{x:Bind P.SignInNotEligible, Mode=OneWay}" local:Fx.Enter="True">
                <TextBlock Text="This ChatGPT plan can't be used in Task Widget. Go, Plus or Pro works." FontSize="12.5"
                           TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" />
                <HyperlinkButton Content="See ChatGPT plans" FontSize="12" Padding="0,2,0,2" NavigateUri="https://chatgpt.com/pricing" />
            </StackPanel>
            <Button Click="SignIn_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,7,12,8"
                    Content="Sign in with ChatGPT" Visibility="{x:Bind P.SignInButton, Mode=OneWay}" />
            <Grid MinHeight="34" ColumnSpacing="8" Visibility="{x:Bind P.SignInWaiting, Mode=OneWay}" local:Fx.Enter="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="14" Height="14" IsActive="{x:Bind P.SignInWaiting, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="Waiting for your browser…" FontSize="13" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="2" Content="Cancel" FontSize="12.5" Click="Cancel_Click" />
            </Grid>
            <Grid MinHeight="34" ColumnSpacing="8" Visibility="{x:Bind P.SignInFailed, Mode=OneWay}" local:Fx.Enter="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource ErrorBrush}" />
                <TextBlock Grid.Column="1" Text="Sign-in didn't finish" FontSize="13" VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind P.SignInCause, Mode=OneWay}" />
                <HyperlinkButton Grid.Column="2" Content="Try again" FontSize="12.5" Click="SignIn_Click" />
            </Grid>
        </StackPanel>

        <!-- B · Cards -->
        <StackPanel Spacing="8" Visibility="{x:Bind P.VB}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="SignIn_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,7,12,8"
                        IsEnabled="{x:Bind local:F.Not(P.SignInWaiting), Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="Sign in with ChatGPT" Visibility="{x:Bind local:F.NV(P.SignInWaiting), Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind P.SignInWaiting, Mode=OneWay}">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind P.SignInWaiting, Mode=OneWay}" />
                            <TextBlock Text="Waiting for your browser…" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Padding="12,7,12,8"
                        Visibility="{x:Bind P.SignInWaiting, Mode=OneWay}" />
            </Grid>
            <InfoBar Severity="Error" Title="Sign-in didn't finish" IsClosable="False" IsOpen="{x:Bind P.SignInFailed, Mode=OneWay}" Visibility="{x:Bind P.SignInFailed, Mode=OneWay}"
                     ToolTipService.ToolTip="{x:Bind P.SignInCause, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Try again" Click="SignIn_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind P.SignInNotEligible, Mode=OneWay}" Visibility="{x:Bind P.SignInNotEligible, Mode=OneWay}"
                     Message="This ChatGPT plan can't be used in Task Widget. Go, Plus or Pro works.">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="See ChatGPT plans" NavigateUri="https://chatgpt.com/pricing" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- C · Header-led: a morphing pill with the status above it -->
        <StackPanel Spacing="8" Visibility="{x:Bind P.VC}" HorizontalAlignment="{x:Bind Align}">
            <TextBlock Text="Sign-in didn't finish" FontSize="12.5" Foreground="{ThemeResource ErrorBrush}"
                       HorizontalAlignment="{x:Bind Align}" ToolTipService.ToolTip="{x:Bind P.SignInCause, Mode=OneWay}"
                       Visibility="{x:Bind P.SignInFailed, Mode=OneWay}" local:Fx.Enter="True" />
            <StackPanel Visibility="{x:Bind P.SignInNotEligible, Mode=OneWay}" local:Fx.Enter="True" MaxWidth="300">
                <TextBlock Text="This ChatGPT plan can't be used in Task Widget. Go, Plus or Pro works." FontSize="12.5"
                           TextWrapping="Wrap" TextAlignment="{x:Bind TextAlign}" Foreground="{ThemeResource ErrorBrush}" />
                <HyperlinkButton Content="See ChatGPT plans" FontSize="12" Padding="0,2,0,2" HorizontalAlignment="{x:Bind Align}"
                                 NavigateUri="https://chatgpt.com/pricing" />
            </StackPanel>
            <Grid MinWidth="240">
                <Button Click="SignIn_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        CornerRadius="17" Height="34" Padding="18,0,18,1" Visibility="{x:Bind local:F.NV(P.SignInWaiting), Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="Sign in with ChatGPT" Visibility="{x:Bind local:F.NV(P.SignInFailed), Mode=OneWay}" />
                        <TextBlock Text="Try again" Visibility="{x:Bind P.SignInFailed, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Border CornerRadius="17" Height="34" Padding="14,0,4,0" Background="{ThemeResource ChipBrush}"
                        BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1"
                        Visibility="{x:Bind P.SignInWaiting, Mode=OneWay}" local:Fx.Enter="True">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind P.SignInWaiting, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="Waiting for your browser…" FontSize="13" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource Bare}" Width="26" Height="26" CornerRadius="13"
                                Click="Cancel_Click" ToolTipService.ToolTip="Cancel">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
