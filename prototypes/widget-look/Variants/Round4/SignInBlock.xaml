<!-- PROTOTYPE · ROUND 4 (finalized: variant A) · The one sign-in flow, shown the same on the welcome card and in
     Settings › Connection. States (from "First run, sign-in and privacy disclosure"): idle, waiting for the browser +
     Cancel, "Sign-in didn't finish" + Try again (cause in a tooltip), plan not eligible. The button is swapped in place
     for a quiet status line. -->
<UserControl
    x:Class="Look.SignInBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <StackPanel Spacing="8">
        <StackPanel Spacing="0" Visibility="{x:Bind P.SignInNotEligible, Mode=OneWay}" local:Fx.Enter="True">
            <TextBlock Text="This ChatGPT plan can't be used in Task Widget. Go, Plus or Pro works." FontSize="12.5"
                       TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" />
            <HyperlinkButton Content="See ChatGPT plans" FontSize="12" Padding="0,2,0,2" NavigateUri="https://chatgpt.com/pricing" />
        </StackPanel>
        <Button Click="SignIn_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,7,12,8"
                Content="Sign in with ChatGPT" Visibility="{x:Bind P.SignInButton, Mode=OneWay}" />
        <Grid MinHeight="34" ColumnSpacing="8" Visibility="{x:Bind P.SignInWaiting, Mode=OneWay}" local:Fx.Enter="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing Width="14" Height="14" IsActive="{x:Bind P.SignInWaiting, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="Waiting for your browser…" FontSize="13" VerticalAlignment="Center" />
            <HyperlinkButton Grid.Column="2" Content="Cancel" FontSize="12.5" Click="Cancel_Click" />
        </Grid>
        <Grid MinHeight="34" ColumnSpacing="8" Visibility="{x:Bind P.SignInFailed, Mode=OneWay}" local:Fx.Enter="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource ErrorBrush}" />
            <TextBlock Grid.Column="1" Text="Sign-in didn't finish" FontSize="13" VerticalAlignment="Center"
                       ToolTipService.ToolTip="{x:Bind P.SignInCause, Mode=OneWay}" />
            <HyperlinkButton Grid.Column="2" Content="Try again" FontSize="12.5" Click="SignIn_Click" />
        </Grid>
    </StackPanel>
</UserControl>
