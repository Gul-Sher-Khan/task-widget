<!-- PROTOTYPE · ROUND 4 · The Widget's header banner: one at a time, newer version > signed out > recovery.
     Copy from "First run, sign-in and privacy disclosure". The signed-out banner runs the shared sign-in flow in place.
     A: a quiet tinted strip under the header.  B: a WinUI InfoBar inset under the header.
     C: a full-width band above the header (the Widget hosts it there). -->
<UserControl
    x:Class="Look.BannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid>
        <!-- ================= A · Quiet strip ================= -->
        <Grid Visibility="{x:Bind P.VA}" Background="{x:Bind BackBrush, Mode=OneWay}" Padding="16,9,12,8" ColumnSpacing="10"
              BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind IconBrush, Mode=OneWay}"
                          Visibility="{x:Bind local:F.NV(Busy), Mode=OneWay}" />
                <ProgressRing Width="14" Height="14" IsActive="{x:Bind Busy, Mode=OneWay}" Visibility="{x:Bind Busy, Mode=OneWay}" />
            </Grid>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Bind Message, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                           ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="-1,0,0,0">
                    <HyperlinkButton Content="{x:Bind PrimaryText, Mode=OneWay}" Click="Primary_Click" FontSize="12.5" Padding="0,2,0,2"
                                     Visibility="{x:Bind local:F.VS(PrimaryText), Mode=OneWay}" />
                    <HyperlinkButton Content="Dismiss" Click="Dismiss_Click" FontSize="12.5" Padding="0,2,0,2"
                                     Visibility="{x:Bind Dismissible, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= B · InfoBar ================= -->
        <InfoBar Visibility="{x:Bind P.VB}" Margin="12,2,12,6" IsOpen="True" Severity="{x:Bind Severity, Mode=OneWay}"
                 Message="{x:Bind Message, Mode=OneWay}" IsClosable="{x:Bind Dismissible, Mode=OneWay}" CloseButtonClick="Close_Click"
                 ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Click="Primary_Click" Content="{x:Bind PrimaryText, Mode=OneWay}" Visibility="{x:Bind local:F.VS(PrimaryText), Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ================= C · Band above the header ================= -->
        <Grid Visibility="{x:Bind P.VC}" Background="{x:Bind BackBrush, Mode=OneWay}">
            <Rectangle Height="2" VerticalAlignment="Top" Fill="{x:Bind IconBrush, Mode=OneWay}" />
            <Grid Padding="16,12,10,10" ColumnSpacing="10" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="18" Height="18" VerticalAlignment="Top">
                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" Foreground="{x:Bind IconBrush, Mode=OneWay}"
                              Visibility="{x:Bind local:F.NV(Busy), Mode=OneWay}" />
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind Busy, Mode=OneWay}" Visibility="{x:Bind Busy, Mode=OneWay}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Message, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                           ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Content="Dismiss" Click="Dismiss_Click" Style="{StaticResource Bare}" Padding="10,4,10,5" FontSize="12.5"
                            Visibility="{x:Bind Dismissible, Mode=OneWay}" />
                    <Button Content="{x:Bind PrimaryText, Mode=OneWay}" Click="Primary_Click" Padding="12,4,12,5" FontSize="12.5"
                            Visibility="{x:Bind local:F.VS(PrimaryText), Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
