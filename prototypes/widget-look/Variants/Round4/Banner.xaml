<!-- PROTOTYPE · ROUND 4 (finalized: variant A) · The Widget's header banner: one at a time, newer version > signed
     out > recovery. Copy from "First run, sign-in and privacy disclosure". A quiet tinted strip under the header with
     link actions; the signed-out banner runs the shared sign-in flow in place. Tint and icon colour are WinUI's status
     brushes (Attention for info, Caution for warning, Critical for error), so they follow the theme and contrast themes. -->
<UserControl
    x:Class="Look.BannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <Grid BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,1">
        <Rectangle Fill="{ThemeResource SystemFillColorAttentionBackgroundBrush}" Visibility="{x:Bind IsInfo, Mode=OneWay}" />
        <Rectangle Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind IsWarning, Mode=OneWay}" />
        <Rectangle Fill="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind IsError, Mode=OneWay}" />
        <Grid Padding="16,9,12,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          Visibility="{x:Bind local:F.Both(IsInfo, NotBusy), Mode=OneWay}" />
                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          Visibility="{x:Bind local:F.Both(IsWarning, NotBusy), Mode=OneWay}" />
                <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          Visibility="{x:Bind local:F.Both(IsError, NotBusy), Mode=OneWay}" />
                <ProgressRing Width="14" Height="14" IsActive="{x:Bind Busy, Mode=OneWay}" Visibility="{x:Bind Busy, Mode=OneWay}" />
            </Grid>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Bind Message, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                           ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="-1,0,0,0">
                    <HyperlinkButton Content="{x:Bind PrimaryText, Mode=OneWay}" Click="Primary_Click" FontSize="12.5" Padding="0,2,0,2"
                                     Visibility="{x:Bind local:F.VS(PrimaryText), Mode=OneWay}" />
                    <HyperlinkButton Content="Dismiss" Click="Dismiss_Click" FontSize="12.5" Padding="0,2,0,2"
                                     Visibility="{x:Bind Dismissible, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
