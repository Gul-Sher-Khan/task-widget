<!-- PROTOTYPE · ROUND 4 · A Capture row that isn't a Task: waiting (offline, signed out, no Connection yet; runs by
     itself later), failed (the Capture text, a one-line reason with the detail in a tooltip, then Retry / Edit /
     Make a Task as-is / Discard; lights the attention dot), or its text open for Edit / Re-interpret.
     The pending row is the finalized one in WidgetA.xaml.
     A: a plain row with link actions.  B: a tinted card with buttons.  C: one compact line; a failed row expands. -->
<UserControl
    x:Class="Look.CaptureRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Look">
    <UserControl.Resources>
        <Style x:Key="Act" TargetType="HyperlinkButton">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,2,0,2" />
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3,8,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="SmallAccent" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3,8,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid local:Fx.Enter="True">
        <!-- ================= A · Quiet ================= -->
        <Grid Visibility="{x:Bind P.VA}">
            <!-- waiting -->
            <Grid Padding="8,7,6,7" ColumnSpacing="10" Visibility="{x:Bind Item.ShowWaiting, Mode=OneWay}" local:Fx.Enter="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" FontSize="13.5" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MutedTextBrush}" />
                    <TextBlock Text="{x:Bind Item.Reason, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource FaintTextBrush}" />
                </StackPanel>
            </Grid>
            <!-- failed -->
            <Grid Padding="8,7,6,6" ColumnSpacing="10" Visibility="{x:Bind Item.ShowFailed, Mode=OneWay}" local:Fx.Enter="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE783;" FontSize="15" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" FontSize="13.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Item.Reason, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource ErrorBrush}"
                               ToolTipService.ToolTip="{x:Bind Item.ReasonTip, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="-1,1,0,0">
                        <HyperlinkButton Content="Retry" Style="{StaticResource Act}" Click="Retry_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}"
                                         FontWeight="{x:Bind Weight(Item.RetryFirst), Mode=OneWay}" />
                        <HyperlinkButton Content="Edit" Style="{StaticResource Act}" Click="Edit_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}" />
                        <HyperlinkButton Content="Make a Task as-is" Style="{StaticResource Act}" Click="Make_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}"
                                         FontWeight="{x:Bind Weight(Item.MakeTaskFirst), Mode=OneWay}" />
                        <HyperlinkButton Content="Discard" Style="{StaticResource Act}" Click="Discard_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!-- editing the Capture text -->
            <Grid Padding="8,6,6,8" ColumnSpacing="10" Visibility="{x:Bind Item.IsEditingCapture, Mode=OneWay}" local:Fx.Enter="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,8,0,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBox x:Name="EditA" FontSize="13.5" Padding="8,5,8,5" MinHeight="0" AcceptsReturn="True" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind EditHint, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource FaintTextBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= B · Cards ================= -->
        <Grid Visibility="{x:Bind P.VB}">
            <!-- waiting: a chip carries the reason -->
            <Grid Padding="8,7,6,7" ColumnSpacing="10" Visibility="{x:Bind Item.ShowWaiting, Mode=OneWay}" local:Fx.Enter="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="17" Height="17" StrokeThickness="1.5" StrokeDashArray="2,2" Stroke="{ThemeResource FaintTextBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{x:Bind Item.Title, Mode=OneWay}" FontSize="13.5" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MutedTextBrush}" />
                <Border Grid.Column="2" CornerRadius="9" Padding="7,1,8,2" Background="{ThemeResource ChipBrush}" VerticalAlignment="Top" MaxWidth="150">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" />
                        <TextBlock Text="{x:Bind Item.Reason, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- failed: tinted card with buttons -->
            <Border Margin="2,3,2,3" Padding="10,8,10,10" CornerRadius="6" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{x:Bind Item.ShowFailed, Mode=OneWay}" local:Fx.Enter="True">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" FontSize="13.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{x:Bind Item.ReasonTip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{x:Bind Item.Reason, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Grid>
                            <Button Content="Retry" Style="{StaticResource SmallAccent}" Click="Retry_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}"
                                    Visibility="{x:Bind Item.RetryFirst, Mode=OneWay}" />
                            <Button Content="Retry" Style="{StaticResource SmallBtn}" Click="Retry_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}"
                                    Visibility="{x:Bind Item.MakeTaskFirst, Mode=OneWay}" />
                        </Grid>
                        <Button Content="Edit" Style="{StaticResource SmallBtn}" Click="Edit_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}" />
                        <Grid>
                            <Button Content="Make a Task as-is" Style="{StaticResource SmallAccent}" Click="Make_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}"
                                    Visibility="{x:Bind Item.MakeTaskFirst, Mode=OneWay}" />
                            <Button Content="Make a Task as-is" Style="{StaticResource SmallBtn}" Click="Make_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}"
                                    Visibility="{x:Bind Item.RetryFirst, Mode=OneWay}" />
                        </Grid>
                        <Button Content="Discard" Style="{StaticResource SmallBtn}" Click="Discard_Click" IsEnabled="{x:Bind P.Editable, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- editing the Capture text -->
            <Border Margin="2,3,2,3" Padding="10,8,10,10" CornerRadius="6" Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1"
                    Visibility="{x:Bind Item.IsEditingCapture, Mode=OneWay}" local:Fx.Enter="True">
                <StackPanel Spacing="8">
                    <TextBox x:Name="EditB" FontSize="13.5" Padding="8,5,8,5" MinHeight="0" AcceptsReturn="True" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SmallBtn}" Click="Cancel_Click" />
                        <Button Content="{x:Bind SubmitText, Mode=OneWay}" Style="{StaticResource SmallAccent}" Click="Submit_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= C · Compact ================= -->
        <Grid Visibility="{x:Bind P.VC}">
            <!-- waiting: one line, reason at the right -->
            <Grid Padding="8,8,10,8" ColumnSpacing="10" Visibility="{x:Bind Item.ShowWaiting, Mode=OneWay}" local:Fx.Enter="True"
                  ToolTipService.ToolTip="{x:Bind Item.Title, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE916;" FontSize="13" Foreground="{ThemeResource FaintTextBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Item.Title, Mode=OneWay}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource MutedTextBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Item.Reason, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource FaintTextBrush}"
                           VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
            </Grid>
            <!-- failed: one line with a dot; click to open the reason and actions -->
            <StackPanel Visibility="{x:Bind Item.ShowFailed, Mode=OneWay}" local:Fx.Enter="True">
                <Grid Padding="8,8,10,8" ColumnSpacing="10" Background="Transparent" Tapped="Toggle_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ErrorBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Item.Title, Mode=OneWay}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Failed" FontSize="11.5" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
                        <FontIcon Glyph="{x:Bind Chevron(Open), Mode=OneWay}" FontSize="9" Foreground="{ThemeResource FaintTextBrush}" />
                    </StackPanel>
                </Grid>
                <local:Accordion IsOpen="{x:Bind Open, Mode=OneWay}">
                    <Grid Padding="40,0,6,8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Item.Reason, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Item.ReasonTip, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource Bare}" Width="28" Height="28" Click="Retry_Click" ToolTipService.ToolTip="Retry"
                                    IsEnabled="{x:Bind P.Editable, Mode=OneWay}">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource Bare}" Width="28" Height="28" Click="Edit_Click" ToolTipService.ToolTip="Edit"
                                    IsEnabled="{x:Bind P.Editable, Mode=OneWay}">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource Bare}" Width="28" Height="28" Click="Make_Click" ToolTipService.ToolTip="Make a Task as-is"
                                    IsEnabled="{x:Bind P.Editable, Mode=OneWay}">
                                <FontIcon Glyph="&#xE73E;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource Bare}" Width="28" Height="28" Click="Discard_Click" ToolTipService.ToolTip="Discard"
                                    IsEnabled="{x:Bind P.Editable, Mode=OneWay}">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </local:Accordion>
            </StackPanel>
            <!-- editing the Capture text: accent-edged, ✓ / ✕ -->
            <Grid Margin="4,3,4,3" Visibility="{x:Bind Item.IsEditingCapture, Mode=OneWay}" local:Fx.Enter="True" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EditC" FontSize="13.5" Padding="8,5,8,5" MinHeight="0" AcceptsReturn="True" TextWrapping="Wrap"
                         BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
                <Button Grid.Column="1" Style="{StaticResource Bare}" Width="28" Height="28" VerticalAlignment="Top" Click="Submit_Click"
                        ToolTipService.ToolTip="{x:Bind SubmitText, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Bare}" Width="28" Height="28" VerticalAlignment="Top" Click="Cancel_Click"
                        ToolTipService.ToolTip="Cancel">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
